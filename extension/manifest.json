{
  "manifest_version": 3,
  "name": "STU AMIS Auto Login",
  "version": "1.0.0",
  "description": "Tiện ích tự động điền và đăng nhập cổng thông tin sinh viên STU AMIS (amis01.stu.edu.vn).",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://amis01.stu.edu.vn/*",
    "https://amis01.stu.edu.vn/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cấu hình STU AMIS Auto Login",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://amis01.stu.edu.vn/*",
        "https://amis01.stu.edu.vn/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
